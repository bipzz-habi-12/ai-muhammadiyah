# Copy to .env.local and fill in real values for local development.
# Only NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are required
# for the app (and middleware/proxy) to boot. The rest enable specific features.

# --- Supabase (required to boot) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase server-only (server data, storage, sync routes) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI providers (chat + embeddings) ---
OPENAI_MODEL=
OPENAI_API_KEY_EMBED=
OPENAI_EMBED_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FLASH_MODEL=
GEMINI_PRO_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
ANTHROPIC_MAX_OUTPUT_TOKENS=

# --- OAuth (Supabase social login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=idr

# --- Encryption / secrets ---
# Random value, minimum 32 characters (BYOK provider key encryption).
USER_API_KEY_ENCRYPTION_KEY=
CONNECTION_ENCRYPTION_KEY=

# --- Second Brain / Logseq bridge (scripts) ---
AIMU_SYNC_TOKEN=
AIMU_SYNC_API=https://aimuhammadiyah.my.id

# --- Admin allowlists (comma-separated emails) ---
HUB_ADMIN_EMAILS=
KNOWLEDGE_ADMIN_EMAILS=
